# ============================================================
# Template variabel rahasia vulnextract
# ============================================================
# 1. Salin file ini menjadi ".env" (sudah ada di .gitignore, aman).
# 2. Isi nilainya sesuai kebutuhan Anda.
# Beda dengan global.yaml: file ini isinya rahasia (token/API key),
# JANGAN pernah commit file ".env" (hasil salinan) ke git.

# Belum dipakai oleh kode saat ini — disiapkan untuk pengembangan
# selanjutnya (mis. mengambil data commit/repo langsung dari GitHub API
# alih-alih dari CSV statis), supaya infrastrukturnya sudah siap.
GITHUB_TOKEN=

# Disiapkan untuk tahap "deteksi vulnerability" (model ML/DL atau LLM)
# yang akan dibangun di atas dataset hasil mode "features" — isi kalau
# nanti tahap itu memanggil API eksternal.
# LLM_API_KEY=
